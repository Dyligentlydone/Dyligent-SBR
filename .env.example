# ── Database ──────────────────────────────────────────────────────────────
# Local dev: `docker compose up -d` starts Postgres with these credentials.
DATABASE_URL="postgresql://dyligent:dyligent@localhost:5432/dyligent_sdr"

# ── Auth (NextAuth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"
# Base URL of the app (used for OAuth redirects).
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────────────────
# Used BOTH for "Sign in with Google" and for the Gmail connection flow
# (the Gmail flow requests extra scopes). Create a Google Cloud OAuth client:
#   Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback/google
#     http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Anthropic (AI drafting) ───────────────────────────────────────────────
# If unset, the app falls back to template-based drafts so the demo still works.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ── Twilio (SMS) ──────────────────────────────────────────────────────────
# If unset, SMS sends are simulated (logged to the activity feed).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Webhook base URL must be publicly reachable for Twilio to call back
# (e.g. an ngrok URL in dev). Falls back to NEXT_PUBLIC_APP_URL.
TWILIO_WEBHOOK_BASE_URL=""

# ── Email sending fallback ────────────────────────────────────────────────
# If RESEND_API_KEY is set and no Gmail is connected, outreach emails are
# sent via Resend from this address. Otherwise emails are simulated.
RESEND_API_KEY=""
RESEND_FROM="Dyligent SDR <outbound@yourdomain.com>"

# ── Cron ──────────────────────────────────────────────────────────────────
# Shared secret to protect /api/cron/tick. Send as `Authorization: Bearer <secret>`
# or ?secret=<secret>. Leave empty to allow unauthenticated access in dev.
CRON_SECRET=""

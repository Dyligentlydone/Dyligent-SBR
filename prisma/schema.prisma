// Dyligent SDR — multi-tenant schema (PostgreSQL)
// Every tenant-owned row carries `tenantId`; all queries must scope by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  image        String?
  createdAt    DateTime     @default(now())
  memberships     Membership[]
  accounts        Account[]
  sessions        Session[]
  authenticators  Authenticator[]
}

// NextAuth adapter models (required by @auth/prisma-adapter)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ── Tenancy ─────────────────────────────────────────────────────────────────

model Tenant {
  id            String   @id @default(cuid())
  name          String
  // Company context fed to the AI
  services      String   @default("") // e.g. "HVAC repair, installs, maintenance"
  serviceArea   String   @default("") // e.g. "Austin metro"
  avgJobValue   String?
  tone          String   @default("friendly") // friendly | professional | casual
  extraContext  String?  @db.Text // freeform notes (warranties, brands, hours…)
  // Auto-learned context: site scrape + Google Business Profile
  websiteUrl        String?
  googleBusinessUrl String?
  businessProfile   String?  @db.Text // extracted intel summary fed to prompts
  // Booking + handoff rules
  bookingLink   String?
  bookingPhone  String?
  handoffRules  String?  @db.Text // freeform: when to bring in the human
  // Behavior
  autoSend          Boolean @default(false) // false = drafts go to review queue
  followUpEnabled   Boolean @default(true)
  followUpDelayHours Int    @default(24)
  maxFollowUps      Int     @default(2)
  dailySendLimit    Int     @default(100)
  // Unique forwarding address token → lead+<token>@<inbound-domain>
  forwardingToken String  @unique @default(cuid())
  // Google sends a confirmation code to our inbound address when the owner
  // adds it in Gmail → Settings → Forwarding. Captured and surfaced in-app.
  forwardingVerifyCode String?
  forwardingVerifyUrl  String?
  onboardingComplete Boolean @default(false)
  // Billing: free until `freeBookingLimit` confirmed bookings OR `trialEndsAt`.
  // subscriptionStatus: TRIAL | ACTIVE | PAUSED | PAST_DUE | CANCELLED
  trialEndsAt        DateTime?
  freeBookingLimit   Int      @default(2)
  confirmedBookings  Int      @default(0)
  subscriptionStatus String   @default("TRIAL")
  stripeCustomerId   String?
  stripePaymentMethodId String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  gmail       GmailConnection?
  twilio      TwilioConnection?
  sendingDomain SendingDomain?
  leads       Lead[]
  messages    Message[]
  tasks       ScheduledTask[]
  activities  ActivityLog[]
}

model Membership {
  id       String @id @default(cuid())
  role     String @default("owner")
  userId   String
  tenantId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

// ── Connections ─────────────────────────────────────────────────────────────

model GmailConnection {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  email        String
  refreshToken String    @db.Text
  accessToken  String?   @db.Text
  expiryDate   BigInt?
  historyId    String? // gmail history cursor for incremental sync
  lastPolledAt DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TwilioConnection {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  phoneNumber   String
  phoneSid      String?
  subAccountSid String? // tenant's own Twilio subaccount — ISV isolation
  subAuthToken  String?
  verificationSid    String? // toll-free verification registration/inquiry id
  verificationStatus String? // NOT_SUBMITTED | NEEDS_OWNER | PENDING_REVIEW | APPROVED | REJECTED
  verificationUrl    String? // Twilio-hosted form the owner completes
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Verified sending domain — lets non-Gmail tenants send "from" their own
// address via Resend (SPF/DKIM verified). status: PENDING | VERIFIED | FAILED
model SendingDomain {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  domain         String // reliableair.com
  resendDomainId String?
  records        String?   @db.Text // JSON DNS records to show the owner
  fromEmail      String // e.g. team@reliableair.com
  replyTo        String // monitored inbox where replies should land
  status         String    @default("PENDING")
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ── Leads & messaging ───────────────────────────────────────────────────────

// status: NEW → OUTREACH_SCHEDULED → CONTACTED → RESPONDED → BOOKED | HANDED_OFF | CLOSED
model Lead {
  id            String   @id @default(cuid())
  tenantId      String
  name          String?
  email         String?
  phone         String?
  source        String? // "website form" | "google business" | "yelp" | "email" …
  summary       String?  @db.Text // what they're asking for
  rawMessage    String?  @db.Text // original inbound content
  status        String   @default("NEW")
  followUpCount Int      @default(0)
  // Owner-confirmed bookings are the billing event — AI only suspects them.
  bookingConfirmed Boolean @default(false)
  gmailThreadId String?
  gmailMessageId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

// channel: EMAIL | SMS · direction: INBOUND | OUTBOUND
// status: DRAFT | SENT | REJECTED | FAILED | RECEIVED
model Message {
  id            String    @id @default(cuid())
  tenantId      String
  leadId        String
  channel       String
  direction     String
  body          String    @db.Text
  subject       String?
  status        String    @default("SENT")
  externalId    String? // provider message/thread id for dedupe + threading
  isAiGenerated Boolean   @default(false)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([leadId, createdAt])
}

// ── Scheduling & logging ────────────────────────────────────────────────────

// type: INITIAL_OUTREACH | FOLLOW_UP · status: PENDING | DONE | CANCELLED | FAILED
model ScheduledTask {
  id          String    @id @default(cuid())
  tenantId    String
  type        String
  payload     String    @db.Text // JSON
  runAt       DateTime
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  tenantId    String
  leadId      String?
  type        String // LEAD_CREATED, OUTREACH_SENT, DRAFT_CREATED, REPLY_RECEIVED, …
  description String   @db.Text
  meta        String?  @db.Text // JSON
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
